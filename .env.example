PUBLIC_BASE_URL=https://gumruksor.com
# Gecis doneminde eski adresin de calismasi icin virgulle ayirarak ek origin verin.
# Ornek: https://www.gumruksor.com,https://mevzuat-mcp.seymata.com
ADDITIONAL_ALLOWED_ORIGINS=
MEVZUAT_DATA_DIR=/data
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SESSION_SECRET=
ADMIN_EMAILS=
# Editoryal inceleme kapisi (PRD Faz 1.3). off: yeni resmi veri surumleri dogrudan yayina
# alinir (varsayilan). auto: kucuk ve uyarisiz farklar otomatik, buyuk farklar / ayristirma
# uyarilari yonetim panelindeki Inceleme Kuyrugu'nda editor onayi bekler. strict: hepsi bekler.
DATA_REVIEW_MODE=off
DATA_REVIEW_MAX_AUTO_ROWS=200
DATA_REVIEW_MAX_AUTO_RATIO=0.02
DATA_REVIEW_BLOCK_ON_WARNINGS=1
# Birincil saglayici Z.ai (Coding Plan). ZAI_API_KEY varsa LLM_BASE_URL varsayilani
# https://api.z.ai/api/coding/paas/v4 olur; yoksa OPENROUTER_API_KEY ile OpenRouter kullanilir.
ZAI_API_KEY=
LLM_BASE_URL=
ZAI_REASONING_EFFORT=low
ZAI_MAX_CONCURRENCY=2
# Gorsel modellerde "dusunme" kapali (hizli yanit). Uzun akil yurutme icin: enabled
ZAI_VISION_THINKING=disabled
# Sure sinirlari (saniye): tek istek / birincil saglayici payi / toplam. Toplam sure
# dolunca kullaniciya net bir hata doner; arayuz sonsuza kadar beklemez.
LLM_REQUEST_TIMEOUT_SECONDS=75
LLM_PRIMARY_BUDGET_SECONDS=95
LLM_TOTAL_DEADLINE_SECONDS=150
# Arac cagiran asistan (POST /api/customs/assistant): en fazla kac deterministik arac
# cagrisi yapilabilir ve tum dongu icin toplam sure siniri (saniye).
ASSISTANT_MAX_TOOL_CALLS=6
ASSISTANT_DEADLINE_SECONDS=170
# Dogrudan Google Gemini (AI Studio anahtari: https://aistudio.google.com/apikey).
# GEMINI_API_KEY tanimliysa Gemini BIRINCIL saglayicidir (Gemini 3.8 Flash); Z.ai yedek olur.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-flash-latest
# kie.ai: tek anahtarla cok saglayicili, OpenAI uyumlu API (GPT-5.x, Gemini 3.x, Claude...).
# Anahtar: https://kie.ai/api-key . Onemli: kie'de ortak bir /chat/completions yolu YOKTUR;
# her model kendi yolunda sunulur (https://api.kie.ai/{model}/v1/chat/completions) ve kod
# URL'yi model basina uretir. Model kimlikleri kie'nin kendi duz adlaridir; OpenRouter'in
# "vendor/model" bicimi burada gecerli DEGILDIR.
KIE_API_KEY=
# kie model zinciri (bos birakilirsa: gemini-3-8-flash-openai,gpt-5-2)
# OPENROUTER_VISION_MODELS / OPENROUTER_CUSTOMS_MODELS degiskenleri kie icin de kullanilir.
# Birincil saglayiciyi zorla: gemini | kie | zai | openrouter (ilgili anahtar tanimli olmali)
LLM_PRIMARY_PROVIDER=
# Yedek sira: Gemini -> kie.ai -> Z.ai -> OpenRouter (birincil haric). OpenRouter yedegi
# varsayilan olarak KAPALI; acmak icin LLM_FALLBACK_TO_OPENROUTER=1.
LLM_FALLBACK_TO_GEMINI=1
LLM_FALLBACK_TO_KIE=1
LLM_FALLBACK_TO_ZAI=1
LLM_FALLBACK_TO_OPENROUTER=0
OPENROUTER_FALLBACK_MODELS=~google/gemini-flash-latest,openai/gpt-chat-latest,~anthropic/claude-opus-latest
OPENROUTER_API_KEY=
# Z.ai ile: OPENROUTER_VISION_MODELS=glm-5v-turbo,glm-4.6v  OPENROUTER_CUSTOMS_MODELS=glm-5.3,glm-5.3-flash
OPENROUTER_VISION_MODELS=~google/gemini-flash-latest,z-ai/glm-5.3-flash,~x-ai/grok-latest,openai/gpt-chat-latest,~anthropic/claude-opus-latest
OPENROUTER_CUSTOMS_MODELS=~google/gemini-flash-latest,z-ai/glm-5.3-flash,~x-ai/grok-latest,openai/gpt-chat-latest,~anthropic/claude-opus-latest
CLASSIFICATION_SYNC_INTERVAL_SECONDS=86400
# Gomme (embedding) saglayicisi: gemini | openrouter | none. Bos birakilirsa GEMINI_API_KEY varsa
# gemini, yoksa OPENROUTER_API_KEY varsa openrouter, hicbiri yoksa kapali (yalniz sozluksel arama).
EMBEDDING_PROVIDER=
# gemini icin varsayilan gemini-embedding-001; openrouter icin google/gemini-embedding-001
EMBEDDING_MODEL=gemini-embedding-001
# Yalniz Gemini yerel ucunda gecerli (outputDimensionality)
EMBEDDING_DIM=768
# Kalici hibrit arama indeksi (BM25 + embedding) yenileme araligi; ilk calisma acilistan 60 sn sonra.
# Yalniz degisen belgeler yeniden gomulur (hybrid_index.sqlite3).
HYBRID_INDEX_REFRESH_SECONDS=1800
# KDV listeleri (2007/13033 eki) mevzuat.gov.tr'den gunluk eşitlenir; 0 kapatir, tohum verisi kullanilir.
VAT_LISTS_SYNC_INTERVAL_SECONDS=86400
# AB-27 KDV oranları: tohumdan okunur, TEDB veri döndürdüğü gün resmî veriyle değişir.
EU_VAT_SYNC_INTERVAL_SECONDS=86400
# Tohum satirlari uzman teyidi tasir; teyit bu gun sayisindan sonra duser ve
# "dogrulanmamis" uyarisi ile oncelikli dogrulama listesi geri gelir.
EU_VAT_CONFIRMATION_MAX_AGE_DAYS=180
# Yurt disi tarife karsilastirma (PRD Faz 4). Birlesik Krallik acik API'sinden fasil listesi gunluk
# esitlenir; pozisyon/emtia govdeleri talep aninda cekilip FOREIGN_TARIFF_CACHE_DAYS kadar onbellege
# alinir. AB (TARIC/EBTI) ve Isvicre (Tares) acik veri yayimlamadigi icin yalniz resmi sorgu baglantisi
# uretilir; hicbir yabanci oran Turkiye maliyet hesabina girmez. 0/false esitlemeyi kapatir.
FOREIGN_TARIFF_SYNC_ENABLED=1
FOREIGN_TARIFF_SYNC_SECONDS=86400
FOREIGN_TARIFF_CACHE_DAYS=7
UK_TARIFF_BASE_URL=https://www.trade-tariff.service.gov.uk/api/v2
# Isvicre BAZG acik verisi: tarife numarasi yapisi (kod + DE/EN/FR tanim + gecerlilik, ~28 MB CSV).
# Oran icermez; oran icin Tares sorgu ekrani baglantisi gosterilir. 0/false esitlemeyi kapatir.
# BK oranlari yalniz emtia basina yayimlaniyor (toplu uc yok). Arsiv arka planda kademeli
# doldurulur; BK erisilemezse son bilinen oran "son alinan tarih" etiketiyle sunulur.
UK_MEASURES_ARCHIVE_ENABLED=1
# Kosu basina kac emtia cekilsin ve istekler arasi bekleme (kaynagi yormamak icin).
UK_MEASURES_BATCH=40
UK_MEASURES_DELAY_SECONDS=1.5
# Arsivdeki bir kod kac gun sonra tazelensin.
UK_MEASURES_REFRESH_DAYS=30
CH_TARIFF_SYNC_ENABLED=1
CH_TARIFF_DATA_URL=https://ocean.bazg.admin.ch/open-data-reports/TN_STRUCTURE_v1/TN_STRUCTURE_v1.csv
# ABD (USITC HTS): anahtarsiz, ucretsiz reststop API'si. UK'nin aksine tek cagrida
# (~36.000 satir, ~13 MB) tum tarife cetvelini General/Special/Other oranlariyla birlikte
# doner; ayri bir emtia-basina arsiv doldurma dongusune gerek yok. Special sutunundaki
# program kisaltmalari (SPI, orn. KR/AU/D) ISO ulke kodu degildir; Turkiye'nin ABD ile
# yururlukte bir anlasmasi olmadigi icin Turk mensei esya her zaman General (NTR/MFN)
# oranini alir. 0/false esitlemeyi kapatir.
US_TARIFF_SYNC_ENABLED=1
US_TARIFF_BASE_URL=https://hts.usitc.gov/reststop
# AB Baglayici Tarife Bilgisi (EBTI) gunluk yayin akisi: Komisyonun her gun yayimladigi ZIP/CSV
# dosyalari indirilir ve aranabilir hale getirilir. Basvuru sahibi ad/adres sutunu hic saklanmaz.
EBTI_SYNC_ENABLED=1
EBTI_SYNC_SECONDS=86400
# Bir esitleme kosusunda en fazla kac gunluk dosya alinsin (ilk dolum icin gecici olarak artirilabilir).
EBTI_MAX_FILES_PER_RUN=8
EBTI_BASE_URL=https://ec.europa.eu/taxation_customs/dds2/ebti
# AB TARIC oranlari: Komisyonun resmi aylik ham veri cikarimini isleyen Apify aktoru uzerinden.
# SORGU BASINA UCRETLIDIR (~$0,015/kod x ulke), bu yuzden varsayilan KAPALIDIR ve arka planda
# kendiliginden calismaz; yalniz kullanici sorguladiginda cagrilir ve sonuc kalici arsive yazilir
# (ayni kod x ulke icin bir daha ucret odenmez). Jeton yalniz bu degiskenden okunur.
EU_TARIC_ENABLED=0
APIFY_TOKEN=
EU_TARIC_ACTOR=nordicdataforge~eu-taric-customs-measures-monitor
EU_TARIC_TIMEOUT_SECONDS=180
# Tum fasillari kapsayan toplu dolum. Adaylar Turk tarife cetvelinden turetilir:
# GTIP'in ilk 8 hanesi AB Kombine Nomanklaturu, 9-10. haneleri AB TARIC alt acilimidir,
# 11-12. haneler ulusaldir; bu yuzden hs10 duzeyinde ilk 10 hane dogrudan AB kodudur.
# Dolum uc kapidan gecer: FILL_ENABLED acik, aylik harcama tavani dolmamis ve cift
# arsivde TAZE degil. MONTHLY_BUDGET_USD=0 iken hicbir sorgu yapilmaz.
# Tazelik takvim ayina degil kaydin YASINA bakar: bir kez indirilen cift kalicidir ve
# yalniz REFRESH_DAYS gectikten sonra yeniden sorgulanir. Boylece katalog bir kez
# doldurulur; sonraki aylarda yalniz tazeleme payi odenir.
EU_TARIC_FILL_ENABLED=0
EU_TARIC_FILL_LEVEL=hs10
EU_TARIC_FILL_ORIGINS=TR,CN
EU_TARIC_FILL_BATCH=40
EU_TARIC_FILL_INTERVAL_SECONDS=900
EU_TARIC_MONTHLY_BUDGET_USD=0
EU_TARIC_UNIT_COST_USD=0.015
EU_TARIC_REFRESH_DAYS=90
EU_TARIC_NOT_DECLARABLE_RETRY_DAYS=180
EU_TARIC_FILL_DELAY_SECONDS=3
# Es zamanli aktor cagrisi (tavan 8). Bir grup 400 alip kod kod yeniden denendiginde
# sirali calismak turu 20-30 dakikaya cikariyor ve dolumu durduruyordu. Aktor sonuc
# basina ucretlendirdigi icin es zamanlilik maliyeti degistirmez. 1 = eski davranis.
EU_TARIC_CONCURRENCY=3
EU_TARIC_FAILED_RETRY_DAYS=7
EU_TARIC_CHUNK_RECOVER_ROUNDS=5

# --- Access2Markets: AYNI AB verisinin UCRETSIZ kaynagi ---------------------------
# Komisyonun Access2Markets portali arkasindaki REST uclari anahtarsiz ve ucretsizdir
# (17.09.2026'da canli olcum: 10/10 basarili, kod basina ~1,3 sn). Ucretli Apify yolunun
# YERINE GECMEZ, yaninda durur; /api/admin/eu-taric/compare ikisini karsilastirir ve
# "Apify durdurulsun mu" karari o olcume gore verilir.
A2M_ENABLED=1
A2M_REFRESH_DAYS=45
A2M_DEFAULT_DESTINATION=DE
A2M_TIMEOUT_SECONDS=45
# Toplu dolum (ucretsiz; tavan yok, yalniz kaynaga saygi icin hiz siniri var).
# Varsayilan ACIK: katalogun tamami bir kez dolunca kullanici sorgusu aga hic cikmaz.
# Olculen kod basina ~2,3 sn (istek + CN8 dusmesi + bekleme): 11.997 kod sirali 7,7
# saat, 3 es zamanli ~2,6 saat. Es zamanlilik ucretsiz kaynakta maliyeti degistirmez.
# INTERVAL yalniz kuyruk BOSKEN kullanilir; is varken BUSY kullanilir.
A2M_FILL_ENABLED=0
A2M_FILL_BATCH=50
A2M_FILL_INTERVAL_SECONDS=900
A2M_FILL_BUSY_SECONDS=10
A2M_CONCURRENCY=3
A2M_DELAY_SECONDS=0.5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EXPERT_MONTHLY=
STRIPE_PRICE_EXPERT_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_AUTOMATIC_TAX=false

# E-posta gönderimi (transactional API)
RESEND_API_KEY=
MAIL_FROM=

# Sunucu tarafı PDF ön değerlendirme raporu (Gümrükçe'ye Sor · pdf_report paket kilidi).
# playwright: başsız Chromium (Docker imajında kurulu) | pymupdf: saf Python yedek | auto: önce Chromium, olmazsa PyMuPDF
PDF_RENDERER=auto
# İsteğe bağlı: Playwright'ın kendi tarayıcısı yerine kullanılacak Chromium/headless_shell yolu
PDF_CHROMIUM_EXECUTABLE=

# Resmî önlem listeleri (damping/korunma/gözetim/İthalat Tebliğleri) günlük eşitleme aralığı (saniye)
TRADE_MEASURES_SYNC_INTERVAL_SECONDS=86400

# Eylemio gümrük otomasyonu köprüsü (beyanname durumu sorgulama; salt okunur)
EYLEMIO_BASE_URL=https://eylemio.com
EYLEMIO_EMAIL=
EYLEMIO_PASSWORD=
EYLEMIO_ACCOUNT_ID=

# Veri diski ve yedek (storage.py). Tum kalici veri MEVZUAT_DATA_DIR altindaki SQLite
# dosyalarinda durur. Yedek yalniz YENIDEN INDIRILEMEYEN veritabanlari icin alinir:
# users (hesaplar, kanit dosyalari), eu_taric (ucret odenerek toplanan arsiv), changes
# (degisiklik defteri), tariff ve controls (resmi sitede artik yayimlanmayan gecmis
# surumler). BK/ABD/Isvicre tarifesi, AB tuzukleri, EBTI ve hibrit indeks resmi
# kaynaktan ucretsiz yeniden kurulabildigi icin yedeklenmez; yedeklemek diski gereksiz
# doldururdu. Kopya `VACUUM INTO` ile alinir (acik yazarlar varken bile tutarli).
# Ayni diskteki yedek diskin tamamen kaybolmasina karsi korumaz; sunucu disina almak
# icin yonetim panelindeki "indir" baglantisi kullanilir.
BACKUP_ENABLED=1
BACKUP_INTERVAL_SECONDS=86400
# Veritabani basina saklanacak kopya sayisi (disk kullanimini sinirlar).
BACKUP_KEEP=2
# Istege bagli: varsayilan kumesi degistirmek icin virgullu liste
# (users,eu_taric,changes,tariff,controls,foreign_tariff,trade_measures,ebti_decisions,
# classification_evidence,hybrid_index)
BACKUP_DATASETS=

# Ihracat dosyasinda ucretsiz AB kaynagina verilen sure (saniye).
A2M_EXPORT_TIMEOUT_SECONDS=12

# Gecici hatalarda (429/5xx) yeniden deneme. Retry-After basligi varsa ona uyulur.
A2M_RETRY_ATTEMPTS=3
A2M_RETRY_BASE_SECONDS=1
A2M_RETRY_MAX_SECONDS=20

# Hiz siniri (429) gorulunce bekleme ikiye katlanir; bu tavana kadar.
A2M_MAX_DELAY_SECONDS=30
A2M_RATE_LIMIT_BASE_SECONDS=5
A2M_PACE_RECOVER_ROUNDS=3

# Devre kesici: art arda bu kadar tur tamamen engellenirse dolum duraklatilir.
A2M_BLOCK_ROUNDS=3
A2M_BLOCK_PAUSE_SECONDS=21600

# UN Comtrade dış ticaret istatistiği (anahtarsız, ücretsiz). İstatistiktir, oran değildir.
COMTRADE_ENABLED=1
COMTRADE_REFRESH_DAYS=90
COMTRADE_DELAY_SECONDS=6
COMTRADE_COOLDOWN_SECONDS=90
COMTRADE_MAX_YEARS=5
COMTRADE_TIMEOUT_SECONDS=45

# Eurostat Comext AB dış ticaret istatistiği (anahtarsız, ücretsiz). İstatistiktir, oran değildir.
COMEXT_ENABLED=1
COMEXT_REFRESH_DAYS=60
COMEXT_DELAY_SECONDS=1
COMEXT_COOLDOWN_SECONDS=60
COMEXT_TIMEOUT_SECONDS=45
# İhracat ön değerlendirmesinde Eurostat pazar bloğu için bekleme; aşılırsa blok boş kalır.
COMEXT_EXPORT_TIMEOUT_SECONDS=8

# Brezilya ComexStat dış ticaret istatistiği (anahtarsız, ücretsiz; hız sınırı sıkı). İstatistiktir, oran değildir.
COMEXSTAT_ENABLED=1
COMEXSTAT_REFRESH_DAYS=60
COMEXSTAT_NCM_REFRESH_DAYS=30
COMEXSTAT_DELAY_SECONDS=6
COMEXSTAT_COOLDOWN_SECONDS=15
COMEXSTAT_TIMEOUT_SECONDS=60
